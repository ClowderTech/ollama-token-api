{
	"imports": {
		"@db/mongo": "jsr:@db/mongo@^0.34.0",
		"@hono/hono": "jsr:@hono/hono@^4.11.1"
	},
	"fmt": {
		"indentWidth": 4,
		"useTabs": true
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"esnext",
			"deno.ns"
		]
	},
	"permissions": {
		"default": {
			"env": true,
			"net": true
		}
	},
	"tasks": {
		"start": "deno run -P src/index.ts",
		"test": "deno test -P",
		"lint": "deno lint",
		"fmt": "deno fmt",
		"check": "deno check --all",
		"lintfix": "deno lint --fix && deno fmt"
	},
	"nodeModulesDir": "auto"
}
