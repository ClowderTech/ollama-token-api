{
  "imports": {
    "hono": "npm:hono",
    "mongodb": "npm:mongodb"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "permissions": {
    "default": {
      "env": true,
      "net": true
    }
  },
  "tasks": {
    "start": "deno run -P src/index.ts",
    "test": "deno test -P",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check --all",
    "lintfix": "deno lint --fix && deno fmt"
  },
  "nodeModulesDir": "auto"
}
