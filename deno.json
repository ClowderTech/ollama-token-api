{
	"imports": {
		"@hono/hono": "jsr:@hono/hono@^4.12.14",
		"mongodb": "npm:mongodb@7.1.1"
	},
	"fmt": {
		"indentWidth": 4,
		"useTabs": true
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"dom.iterable",
			"esnext",
			"deno.ns"
		]
	},
	"permissions": {
		"default": {
			"env": true,
			"net": true,
			"read": true,
			"sys": true
		}
	},
	"tasks": {
		"start": "deno run -A src/index.ts",
		"test": "deno test -A",
		"lint": "deno lint",
		"fmt": "deno fmt",
		"check": "deno check --all",
		"lintfix": "deno lint --fix && deno fmt"
	},
	"nodeModulesDir": "auto"
}